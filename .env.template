# Настройки Django
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,db

# База данных PostgreSQL (настройки для контейнеров)
DATABASE_URL=postgres://postgres:postgres@db:5432/habit_tracker
POSTGRES_DB=habit_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Настройки Celery и Брокера (контейнеры общаются через хост 'redis')
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Настройки CORS и Telegram
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=ваша_строка_токена_робота

